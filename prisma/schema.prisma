datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  passwordHash        String
  displayName         String
  avatarUrl           String?
  phone               String?
  status              String               @default("offline") // "online", "offline", "away"
  lastSeen            DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  conversations       ConversationMember[]
  messages            Message[]
  createdConversations Conversation[]
  reminders           Reminder[]
}

model Conversation {
  id          String               @id @default(uuid())
  name        String? // NULL if 1v1 chat
  isGroup     Boolean              @default(false)
  avatarUrl   String?
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ConversationMember[]
  messages    Message[]
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname       String? // Alias in conversation
  role           String       @default("member") // "creator", "admin", "member"
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type           String // "text", "image", "file", "voice", "location", "sticker", "reminder"
  content        String? // Message body or file link
  metadata       String? // JSON string: {lat, lng, address} or {fileSize, mimeType} or {duration} or {stickerId}
  isPinned       Boolean       @default(false)
  pinnedBy       String?
  pinnedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reminders      Reminder[]
}

model Reminder {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title     String
  remindAt  DateTime
  status    String   @default("pending") // "pending", "sent", "cancelled"
  createdAt DateTime @default(now())
}
