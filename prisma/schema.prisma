datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String               @id @default(uuid())
  username             String               @unique
  passwordHash         String
  displayName          String
  avatarUrl            String?
  phone                String?
  status               String               @default("offline") // "online", "offline", "away"
  lastSeen             DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  conversations        ConversationMember[]
  messages             Message[]
  createdConversations Conversation[]
  reminders            Reminder[]
  messageReactions     MessageReaction[]
  messageDeletions     MessageDeletion[]
  pushSubscriptions    PushSubscription[]
  assignedTasks        Task[]               @relation("AssignedTasks")
  receivedTasks        Task[]               @relation("ReceivedTasks")

  @@index([displayName])
  @@index([phone])
  @@index([status])
}

model Conversation {
  id          String               @id @default(uuid())
  name        String? // NULL if 1v1 chat
  isGroup     Boolean              @default(false)
  avatarUrl   String?
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ConversationMember[]
  messages    Message[]
  tasks       Task[]
  reminders   Reminder[]

  @@index([updatedAt(sort: Desc)])
  @@index([isGroup, name])
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname       String? // Alias in conversation
  role           String       @default("member") // "creator", "admin", "member"
  lastReadAt     DateTime     @default(now())
  isMuted        Boolean      @default(false)
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String            @id @default(uuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type           String // "text", "image", "file", "voice", "location", "sticker", "reminder", "task", "call", "system"
  content        String? // Message body or local SSD file URL (/api/uploads/...)
  metadata       String? // JSON string: {lat, lng, address} or {fileSize, mimeType, fileName} or {duration} or {stickerId}
  isPinned       Boolean           @default(false)
  pinnedBy       String?
  pinnedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reminders      Reminder[]
  replyToId      String?
  replyTo        Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]         @relation("MessageReplies")
  isRecalled     Boolean           @default(false)
  reactions      MessageReaction[]
  deletions      MessageDeletion[]
  task           Task?

  @@index([conversationId, createdAt])
  @@index([conversationId, isPinned])
  @@index([conversationId, type, isRecalled])
  @@index([senderId])
}

model Reminder {
  id             String        @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  creatorId      String
  creator        User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title          String
  remindAt       DateTime
  status         String        @default("pending") // "pending", "sent", "cancelled"
  createdAt      DateTime      @default(now())

  @@index([status, remindAt])
  @@index([conversationId])
  @@index([creatorId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  type      String // 👍, ❤️, 😂, 😮, 😭, 😡
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model MessageDeletion {
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  keysP256dh String
  keysAuth   String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  dueDate        DateTime?
  status         String       @default("pending") // "pending", "in_progress", "done", "cancelled"
  assignerId     String
  assigner       User         @relation("AssignedTasks", fields: [assignerId], references: [id], onDelete: Cascade)
  assigneeId     String
  assignee       User         @relation("ReceivedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?      @unique
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([assigneeId, status])
  @@index([assignerId, status])
  @@index([conversationId, createdAt(sort: Desc)])
}
