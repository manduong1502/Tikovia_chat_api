# === ChatTikovia Server — Cấu hình Môi trường ===

# Cổng chạy server
PORT=5000

# Chuỗi bí mật dùng để ký JWT tokens (BẮT BUỘC đổi cho production!)
JWT_SECRET="your_super_secret_key_here"

# Database connection string
# - Dev (SQLite): file:./dev.db
# - Production (PostgreSQL): postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Thư mục lưu file tải lên (fallback khi không dùng Google Drive)
UPLOAD_DIR="./uploads"

# CORS: Danh sách domain cho phép kết nối (phân cách bằng dấu phẩy)
# Để trống hoặc không đặt → cho phép tất cả (chỉ dùng cho dev)
# CORS_ORIGINS=https://chat.tikovia.vn,https://admin.tikovia.vn

# Redis URL cho rate limiting phân tán (tùy chọn, có fallback in-memory)
# REDIS_URL=redis://127.0.0.1:6379

# === Google Drive Integration (tùy chọn) ===
# Phương thức 1: OAuth2 (Gmail cá nhân)
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# Phương thức 2: Service Account (Google Workspace)
# Đặt file google-credentials.json vào thư mục gốc server
# GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# API Key để hệ thống bên ngoài (KiotViet) gọi vào tạo task
# SYSTEM_API_KEY=your_system_api_key_here
