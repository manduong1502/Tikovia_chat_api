# === ChatTikovia Server — Cấu hình Môi trường (PostgreSQL 16 + Local SSD) ===

# Cổng chạy server
PORT=5000

# Chuỗi bí mật dùng để ký JWT tokens (BẮT BUỘC đổi cho production!)
JWT_SECRET="your_super_secret_key_here"

# Database connection string (PostgreSQL 16)
DATABASE_URL="postgresql://chattikovia:chattikovia_pg_pass@chattikovia-postgres:5432/chattikovia?schema=public"

# Thư mục lưu toàn bộ file tải lên trên ổ cứng SSD của Ubuntu Mini Server
UPLOAD_DIR="./uploads"

# Giới hạn dung lượng tải lên tối đa (MB)
MAX_FILE_SIZE_MB=50

# CORS: Danh sách domain cho phép kết nối (phân cách bằng dấu phẩy)
# Để trống hoặc '*' -> cho phép tất cả (dùng khi chạy sau Nginx reverse proxy nội bộ)
# CORS_ORIGINS=https://chat.tikovia.com,http://localhost:5173

# Redis URL cho rate limiting phân tán
REDIS_URL="redis://chattikovia-redis:6379"

# Web Push VAPID Keys (Giữ cố định để thông báo trên điện thoại không bị mất khi rebuild Docker)
# Nếu để trống, hệ thống sẽ tự động sinh và lưu cố định vào /app/uploads/.vapid.json
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT="mailto:admin@tikovia.com"

# API Key để hệ thống bên ngoài (KiotViet) gọi vào tạo task Kho Đông Lạnh
# SYSTEM_API_KEY=your_system_api_key_here
